# Environment variables used by the serverless functions in api/.
# Set these in the Vercel dashboard (Settings -> Environment Variables).
# Placeholder values only — never commit real credentials.

# --- SMTP transport (shared by send-contact and send-enquiry) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-username
SMTP_PASS=smtp-password

# Envelope sender for outbound mail.
FROM_EMAIL=bamboo.admin@gjsdillon.co.uk

# --- Contact form (api/send-contact.js) ---
# Primary recipient of website contact form submissions.
TO_CONTACT=info@gjsdillon.co.uk

# CRM intake address (Flight). A copy of each contact form submission is sent here
# in addition to TO_CONTACT. This send is best effort: if it fails, the submission
# still succeeds and TO_CONTACT still receives the enquiry.
# Comma-separate for multiple recipients. Set to an empty string to disable the copy.
# Currently pointed at the UAT/test system — replace with the live address when Flight
# confirm it is ready.
TO_CRM=6aa15b6a07cc4-gjs-dillon-uat@uat-app.co.uk

# --- Property enquiries (api/send-enquiry.js) ---
# Kato parse address that receives property enquiries.
PARSE_EMAIL=gjs-dillon-limited-393@parse.agents-society.com

# --- CORS ---
# Comma-separated list of origins allowed to POST to the API. Defaults to '*'.
CORS_ORIGINS=https://www.gjsdillon.co.uk,https://gjsdillon.co.uk

# --- Google Maps (api/maps-key.js) ---
# Browser key, restricted by HTTP referrer in Google Cloud.
GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
